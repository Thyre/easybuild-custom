easyblock = 'CMakeMake'

name = 'hipCUB'
version = '3.3.0'
_rocm_version = '6.4.1'
versionsuffix = f'-ROCm-{_rocm_version}'

homepage = 'https://github.com/ROCm/hipCUB'
description = """hipCUB is a thin wrapper library on top of rocPRIM or CUB.
You can use it to port a CUB project into HIP so you can use AMD hardware (and ROCm software)."""
docurls = ['https://rocm.docs.amd.com/projects/hipCUB/en/latest/']

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

github_account = 'ROCm'
source_urls = [GITHUB_SOURCE]
sources = [f'rocm-{_rocm_version}.tar.gz']
checksums = ['93a213a37142ae38518b6d912b89dc0ecb50e092ce84df4cb06447f1528fcc29']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.31.3'),
]
dependencies = [
    ('ROCm-LLVM', f'{_rocm_version}'),
    ('HIP', f'{_rocm_version}', '-amd'),
    ('rocPRIM', '3.4.0', f'-ROCm-{_rocm_version}')
]

# We use non rpath wrapper until we have a proper toolchain.
# Therefore, ROCm rpath test fails expectedly
check_readelf_rpath = False

configopts = '-DCMAKE_C_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang '
configopts += ' -DCMAKE_CXX_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang++ '
configopts += ' -DCMAKE_HIP_COMPILER=$EBROOTHIP/bin/hipcc '
# Build options as specified in AMD build scripts and TheRock monobuild repo
configopts += '-DHIP_PLATFORM=amd '
# TODO: Replace with build option provided by Framework PR: EasyBlock?
configopts += '-DAMDGPU_TARGETS=gfx1201 '


sanity_check_paths = {
    'files': ['lib/cmake/hipcub/hipcub-config.cmake',
              'include/hipcub/hipcub.hpp'],
    'dirs': ['lib/cmake/hipcub',
             'share/doc/hipcub',
             'include/hipcub'],
}

moduleclass = 'lib'
