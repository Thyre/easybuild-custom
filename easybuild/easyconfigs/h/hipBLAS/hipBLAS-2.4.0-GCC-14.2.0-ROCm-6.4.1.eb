easyblock = 'CMakeMake'

name = 'hipBLAS'
version = '3.3.0'
_rocm_version = '6.4.1'
versionsuffix = f'-ROCm-{_rocm_version}'

homepage = 'https://github.com/ROCm/hipBLAS'
description = """hipBLAS is a Basic Linear Algebra Subprograms (BLAS) marshalling
library with multiple supported backends. It sits between your application and a
'worker' BLAS library, where it marshals inputs to the backend library and marshals
results to your application. hipBLAS exports an interface that doesn't require the
client to change, regardless of the chosen backend. Currently, hipBLAS supports
rocBLAS and cuBLAS backends."""
docurls = ['https://rocm.docs.amd.com/projects/hipBLAS/en/latest/']

toolchain = {'name': 'GCC', 'version': '14.2.0'}

github_account = 'ROCm'
source_urls = [GITHUB_SOURCE]
sources = [f'rocm-{_rocm_version}.tar.gz']
checksums = ['3fa0a690bf96104afb093d19a4f565012a59ab6df378df8aef5420914e82d91b']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.31.3'),
]
dependencies = [
    ('ROCm-LLVM', f'{_rocm_version}'),
    ('HIP', f'{_rocm_version}', '-amd'),
    ('rocBLAS', '4.4.0', f'-ROCm-{_rocm_version}'),
    ('rocSPARSE', '3.4.0', f'-ROCm-{_rocm_version}'),
    ('rocSOLVER', '3.28.0', f'-ROCm-{_rocm_version}'),
    ('Python', '3.13.1'),
    ('PyYAML', '6.0.2'),
    ('hipBLAS-common', '1.2.0', f'-ROCm-{_rocm_version}')
]

# We use non rpath wrapper until we have a proper toolchain.
# Therefore, ROCm rpath test fails expectedly
check_readelf_rpath = False

configopts = '-DCMAKE_C_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang '
configopts += ' -DCMAKE_CXX_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang++ '
configopts += ' -DCMAKE_HIP_COMPILER=$EBROOTHIP/bin/hipcc '
# Build options as specified in AMD build scripts and TheRock monobuild repo
configopts += '-DHIP_PLATFORM=amd -DHIP_DIR=$EBROOTHIP '
# TODO: Replace with build option provided by Framework PR: EasyBlock?
configopts += '-DAMDGPU_TARGETS=gfx1201 '
# Disable building external components
configopts += "-DBUILD_GTEST=OFF -DBUILD_LAPACK=OFF "

# TODO: Patch CMake to correctly use our libraries instead of checking /opt/rocm first.

sanity_check_paths = {
    'files': ['lib/cmake/hipblas/hipblas-config.cmake',
              'include/hipblas/hipblas.h'],
    'dirs': ['lib/cmake/hipblas',
             'share/doc/hipblas',
             'include/hipblas'],
}

moduleclass = 'lib'
