easyblock = 'CMakeMake'

name = 'rocPRIM'
version = '3.4.0'
_rocm_version = '6.4.1'
versionsuffix = f'-ROCm-{_rocm_version}'

homepage = 'https://github.com/ROCm/rocPRIM'
description = """rocPRIM is a header-only library that provides HIP parallel primitives.
You can use this library to develop performant GPU-accelerated code on AMD ROCm platforms."""
docurls = ['https://rocm.docs.amd.com/projects/rocPRIM/en/latest/']

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

github_account = 'ROCm'
source_urls = [GITHUB_SOURCE]
sources = [f'rocm-{_rocm_version}.tar.gz']
checksums = ['ff84b839bbe07fd2c97771c1b864dac641bfa654a652e75b0e7fed5e3ec5bb7c']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.31.3'),
]
dependencies = [
    ('ROCm-LLVM', f'{_rocm_version}'),
    ('HIP', f'{_rocm_version}', '-amd')
]

# We use non rpath wrapper until we have a proper toolchain.
# Therefore, ROCm rpath test fails expectedly
check_readelf_rpath = False

configopts = '-DCMAKE_C_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang '
configopts += ' -DCMAKE_CXX_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang++ '
# Build options as specified in AMD build scripts and TheRock monobuild repo
configopts += '-DHIP_PLATFORM=amd '
# TODO: Replace with build option provided by Framework PR: EasyBlock?
configopts += '-DGPU_TARGETS=gfx1201 '


sanity_check_paths = {
    'files': ['lib/cmake/rocprim/rocprim-config.cmake',
              'include/rocprim/rocprim.hpp'],
    'dirs': ['lib/cmake/rocprim',
             'share/doc/rocprim',
             'include/rocprim'],
}

moduleclass = 'lib'
