easyblock = 'CMakeMake'

name = 'rocThrust'
version = '3.3.0'
_rocm_version = '6.4.1'
versionsuffix = f'-ROCm-{_rocm_version}'

homepage = 'https://github.com/ROCm/rocThrust'
description = """Thrust is a parallel algorithm library. It has been ported to HIP and ROCm,
which use the rocPRIM library. The HIP-ported library works on HIP and ROCm software.
Currently there is no CUDA backend in place."""
docurls = ['https://rocm.docs.amd.com/projects/rocThrust/en/latest/']

toolchain = {'name': 'GCCcore', 'version': '14.2.0'}

github_account = 'ROCm'
source_urls = [GITHUB_SOURCE]
sources = [f'rocm-{_rocm_version}.tar.gz']
checksums = ['1b50e504b81ddadc4cf086aa48e4dbff26e6e0051fc48bf3b0438308890114d6']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.31.3'),
]
dependencies = [
    ('ROCm-LLVM', f'{_rocm_version}'),
    ('HIP', f'{_rocm_version}', '-amd'),
    ('rocPRIM', '3.4.0', f'-ROCm-{_rocm_version}'),
    ('rocRAND', '3.3.0', f'-ROCm-{_rocm_version}'),
    # Tests will require SQLite, and a patch to remove the forced download of it
]

# We use non rpath wrapper until we have a proper toolchain.
# Therefore, ROCm rpath test fails expectedly
check_readelf_rpath = False

configopts = '-DCMAKE_C_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang '
configopts += ' -DCMAKE_CXX_COMPILER=$EBROOTROCMMINLLVM/bin/amdclang++ '
# Build options as specified in AMD build scripts and TheRock monobuild repo
configopts += '-DHIP_PLATFORM=amd '
configopts += '-DGPU_TARGETS=%(amdgcn_cc_semicolon_sep)s '


sanity_check_paths = {
    'files': ['lib/cmake/rocthrust/rocthrust-config.cmake',
              'include/thrust/rocthrust_version.hpp'],
    'dirs': ['lib/cmake/rocthrust',
             'share/doc/rocthrust',
             'include/thrust'],
}

moduleclass = 'lib'
